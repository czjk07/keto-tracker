<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/meal_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/meal_name_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meal_box_0"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/meal_liquid_0"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/meal_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/meal_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meal_box_1"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/meal_liquid_1"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/meal_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/meal_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meal_box_2"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/meal_liquid_2"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
